{
  "server": {
    "host": "0.0.0.0",
    "port": 8010,
    "reload": false
  },
  "database": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "root",
    "password": "",
    "password_env": "SEMIKB_DB_PASSWORD",
    "db": "semi_kb_db",
    "charset": "utf8mb4",
    "pool_min": 2,
    "pool_max": 10
  },
  "milvus": {
    "uri": "http://127.0.0.1:19530",
    "collection": "semi_kb_chunks",
    "physical_prefix": "semi_kb_chunks_v",
    "default_physical": "semi_kb_chunks_v1",
    "consistency": "Strong",
    "top_k": 4,
    "candidate_limit": 20,
    "score_threshold": 0.0,
    "ranker_k": 100,
    "expr": "category == \"content\""
  },
  "embedding": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "text-embedding-v4",
    "dim": 1024,
    "batch": 10,
    "api_key_env": "DASHSCOPE_API_KEY"
  },
  "llm": {
    "chat": {
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-plus",
      "api_key_env": "DASHSCOPE_API_KEY",
      "temperature": 0,
      "max_tokens": 900,
      "timeout_seconds": 45,
      "streaming": true,
      "max_retries": 2
    },
    "grader": {
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-plus",
      "api_key_env": "DASHSCOPE_API_KEY",
      "temperature": 0,
      "max_tokens": 220,
      "timeout_seconds": 30,
      "max_retries": 1
    }
  },
  "rag": {
    "recursion_limit": 20,
    "wall_timeout_seconds": 90,
    "max_llm_calls": 12,
    "transform_max": 2,
    "generation_max": 2,
    "history_turns": 3,
    "context_char_limit": 8000,
    "max_concurrent_questions": 8,
    "fallback_message": "文档库里没有找到足够可靠的依据，建议换一种问法，或者补充具体的工艺名词后再试。",
    "no_result_message": "这次没有检索到相关文档，也没有从联网结果中找到可靠信息。可以换一个更具体的工艺名词或设备名称再问一次。",
    "domain_keywords": [
      "半导体", "芯片", "晶圆", "光刻", "封装", "测试", "清洗", "蚀刻",
      "刻蚀", "薄膜", "沉积", "离子注入", "掺杂", "光刻胶", "化学机械抛光",
      "cmp", "euv", "duv", "mems", "键合", "制程", "纳米", "集成电路",
      "硅片", "掩模", "量测", "可靠性", "晶圆厂", "先进节点", "gaafet",
      "finfet", "3d nand", "hbm", "先进封装", "cowos", "tsv", "ald", "cvd",
      "pvd", "rie", "立式炉", "外延", "退火", "平坦化", "缺陷检测",
      "晶体管", "金属栅", "高介电", "栅极", "漏电流", "短沟道", "介电常数",
      "hkmg", "high-k", "low-k", "soi", "mosfet", "cmos", "igbt", "功率器件",
      "铜互连", "互连", "阻挡层", "种子层", "电镀", "钨塞", "接触孔",
      "sram", "dram", "nand", "存储单元", "逻辑器件", "模拟电路", "射频"
    ],
    "suggestions": [
      "EUV 光刻胶的分辨率极限如何突破",
      "3D NAND 堆叠工艺的主要挑战是什么",
      "GAAFET 相比 FinFET 有哪些优势",
      "CMP 在先进制程中起什么作用"
    ]
  },
  "web_search": {
    "provider": "tavily",
    "max_results": 3,
    "search_depth": "basic",
    "timeout_seconds": 20,
    "api_key_env": "TAVILY_API_KEY"
  },
  "ingest": {
    "max_workers": 2,
    "max_file_mb": 5,
    "max_files_per_upload": 20,
    "chunk_char_limit": 5000,
    "chunk_hard_max": 2400,
    "chunk_overlap": 120,
    "min_chunk_chars": 80,
    "batch_embed": 10,
    "batch_insert": 50,
    "extensions": [".md", ".markdown"]
  },
  "rate_limit": {
    "chat_per_minute": 20,
    "session_per_minute": 10,
    "admin_login_per_minute": 5,
    "retrieval_test_per_minute": 30,
    "qa_test_per_minute": 10,
    "upload_per_hour": 30
  },
  "admin": {
    "password_salt": "semi-kb",
    "token_ttl_hours": 8,
    "token_secret_env": "SEMIKB_ADMIN_SECRET",
    "token_secret": "semi-kb-dev-secret-change-me"
  },
  "log": {
    "level": "INFO",
    "dir": "logs",
    "file": "server.log",
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "brand": {
    "name": "芯知 SemiKB",
    "slogan": "让每一份工艺文档都能被问出来",
    "org_name": "半导体文档知识库"
  }
}
